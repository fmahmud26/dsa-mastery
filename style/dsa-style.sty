% dsa-style.sty: shared design system for every DSA Mastery PDF.
% Adapted from the billionaire-guideline design: navy/teal/gold palette, per-section accent
% colours, numbered section badges, gold-bar subsections, top colour strip, page-number pill.
% Requires XeLaTeX (fontspec + the Inter font family installed on the system).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dsa-style}[2026/11/09 DSA Mastery shared style]

%-------------------------------------------------------------- FONTS
\RequirePackage{fontspec}
\setmainfont{Inter}[
  Ligatures      = TeX,
  UprightFont    = *-Regular,
  BoldFont       = *-Bold,
  ItalicFont     = *-Italic,
  BoldItalicFont = *-BoldItalic
]
\setmonofont{DejaVu Sans Mono}[Scale=0.84]
\newfontfamily\semibold{Inter SemiBold}[Ligatures=TeX]
\newfontfamily\extrabold{Inter ExtraBold}[Ligatures=TeX]
\RequirePackage[protrusion=true, expansion=false]{microtype}
\RequirePackage[newcommands]{ragged2e}

\RequirePackage[margin=0.6in]{geometry}
\RequirePackage[table]{xcolor}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage[most]{tcolorbox}
\RequirePackage{fancyhdr}
\RequirePackage{amssymb}
\RequirePackage{needspace}
\RequirePackage{tikz}
\RequirePackage{etoolbox}
\RequirePackage{xurl}
\RequirePackage{listings}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{bookmark}
\usetikzlibrary{positioning,arrows.meta,calc,fit,backgrounds}
\urlstyle{same}

%-------------------------------------------------------------- COLORS
\definecolor{navy}{HTML}{0B2545}
\definecolor{teal}{HTML}{13837A}
\definecolor{gold}{HTML}{C9A227}
\definecolor{softgray}{HTML}{F4F6F9}
\definecolor{alert}{HTML}{B23A48}
\definecolor{muted}{HTML}{5B6573}
\definecolor{ink}{HTML}{1F2933}
\definecolor{sky}{HTML}{2D7DD2}
\definecolor{violet}{HTML}{7B4FC9}
\definecolor{orange}{HTML}{E07A1F}
\definecolor{green}{HTML}{2E9E5B}
\definecolor{indigo}{HTML}{3F51B5}
\definecolor{magenta}{HTML}{C2407A}
\definecolor{amber}{HTML}{B07D12}
\definecolor{coral}{HTML}{E4572E}
\definecolor{cyan}{HTML}{0E8FA0}
% semantic aliases used by diagrams and complexity colouring
\colorlet{accent}{teal}   % neutral element
\colorlet{soft}{teal!9}   % neutral fill
\colorlet{good}{green}    % fast / correct / found
\colorlet{warn}{orange}   % moving / medium cost
\colorlet{bad}{alert}     % slow / deleted / not found
\colorlet{cmt}{muted}
% each numbered section gets its own accent colour (badges, bullets, tables, boxes)
\colorlet{seccol}{teal}
\newcommand{\setseccol}{\xglobal\colorlet{seccol}{\ifcase\value{section}teal\or teal\or sky\or violet\or orange\or
  green\or indigo\or magenta\or amber\or coral\or cyan\or alert\else teal\fi}}

\hypersetup{colorlinks=true, urlcolor=teal, linkcolor=navy}
\AtBeginDocument{\setlength{\RaggedRightParfillskip}{0pt plus 0.55\textwidth}\color{ink}\RaggedRight}
\setlength{\RaggedRightRightskip}{0pt plus 4em}
\hyphenpenalty=10000
\exhyphenpenalty=10000
\setlength{\emergencystretch}{1em}
\newcommand{\cellragged}{\setlength{\rightskip}{0pt plus 0.3\hsize}\setlength{\parfillskip}{0pt plus 0.45\hsize}}

%-------------------------------------------------------------- TEXT
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlength{\topsep}{3pt plus 1pt minus 1pt}
\setlength{\partopsep}{0pt}
\widowpenalty=10000
\clubpenalty=10000
\setlist{itemsep=2pt, topsep=3pt, leftmargin=16pt, before={\setlength{\parfillskip}{0pt plus 0.55\linewidth}}}
\setlist[itemize]{label={\color{seccol}\small$\bullet$}}
\setlist[enumerate]{label={\color{seccol}\semibold\arabic*.}}
% Big-O in Inter instead of the math font
\newcommand{\On}[1]{\textbf{O(#1)}}

%-------------------------------------------------------------- TABLES
\renewcommand{\arraystretch}{1.45}
\setlength{\aboverulesep}{0pt}
\setlength{\belowrulesep}{0pt}
\setlength{\heavyrulewidth}{1pt}
\setlength{\lightrulewidth}{0.4pt}
\arrayrulecolor{teal!70}
\AtBeginEnvironment{tabularx}{\arrayrulecolor{seccol!70}\rowcolors{2}{white}{softgray}}
\newcommand{\hrow}{\rowcolor{seccol!14}}
\newcolumntype{L}{>{\cellragged\arraybackslash}X}

%-------------------------------------------------------------- HEADINGS
\newcommand{\secbadge}[1]{\tikz[baseline=(b.base)]\node[fill=seccol, text=white, rounded corners=4pt,
  minimum width=0.9cm, minimum height=0.8cm, inner sep=0pt, font=\extrabold\large](b){#1};}
\titleformat{\section}[hang]{\Needspace{12\baselineskip}\extrabold\LARGE\color{navy}}
  {\setseccol\secbadge{\thesection}}{0.45em}{}[\vspace{3pt}{\color{seccol!35}\titlerule[1pt]}]
\titleformat{name=\section,numberless}[hang]{\Needspace{12\baselineskip}\extrabold\LARGE\color{navy}}
  {\xglobal\colorlet{seccol}{teal}}{0pt}{}[\vspace{3pt}{\color{seccol!35}\titlerule[1pt]}]
\titleformat{\subsection}[hang]{\Needspace{10\baselineskip}\semibold\large\color{seccol}}
  {}{0pt}{\textcolor{gold}{\rule[-0.18em]{3pt}{1.05em}}\hspace{7pt}}
\titlespacing*{\section}{0pt}{16pt}{8pt}
\titlespacing*{\subsection}{0pt}{11pt}{4pt}

\setcounter{tocdepth}{1}
\titlecontents{section}[2.2em]{\vspace{3pt}}
  {\contentslabel[{\semibold\color{teal}\thecontentslabel}]{2.2em}}
  {}{\titlerule*[0.6pc]{\color{muted!50}.}\semibold\color{teal}\contentspage}

%-------------------------------------------------------------- PAGE FRAME
% set \dsalesson{Lesson 1} and \dsatopic{The Array} in the document before \begin{document}
\newcommand{\dsalesson}{DSA Mastery}
\newcommand{\dsatopic}{}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyhead[C]{\begin{tikzpicture}[remember picture, overlay]
  \fill[navy] (current page.north west) rectangle ([yshift=-0.16cm]current page.north east);
  \foreach \c [count=\i from 0] in {teal,sky,violet,magenta,coral,orange,gold}
    \fill[\c] ([xshift=\i*\paperwidth/7, yshift=-0.16cm]current page.north west) rectangle ++(\paperwidth/7,-0.09cm);
\end{tikzpicture}}
\fancyfoot[L]{\footnotesize{\semibold\color{navy}DSA Mastery}\textcolor{teal!60}{\quad|\quad}%
  {\color{muted}\dsalesson\ \ $\cdot$\ \ \dsatopic}}
\fancyfoot[R]{\tikz[baseline=(p.base)]\node[fill=teal, text=white, rounded corners=7pt, inner xsep=7pt,
  inner ysep=2.5pt, font=\footnotesize\semibold](p){\thepage};}
\setlength{\footskip}{16pt}
\setlength{\headheight}{14pt}

%-------------------------------------------------------------- BOXES
\newcommand{\boxtitle}[1]{{\footnotesize\addfontfeature{LetterSpace=6}\MakeUppercase{#1}}}
% \begin{callout}[colour]{Title}: the standard note box (default colour = section colour)
\newtcolorbox{callout}[2][seccol]{enhanced, colback=#1!6, colframe=#1,
  boxrule=0pt, leftrule=4pt, arc=4pt, left=10pt, right=10pt, top=7pt, bottom=7pt,
  fonttitle=\semibold, coltitle=#1, title={\boxtitle{#2}}, attach title to upper={\par\smallskip},
  before skip=8pt, after skip=8pt}

%-------------------------------------------------------------- CODE
\lstdefinelanguage{Go}{
  morekeywords={break,case,chan,const,continue,default,defer,else,fallthrough,for,func,go,goto,if,import,interface,map,package,range,return,select,struct,switch,type,var},
  morekeywords=[2]{int,string,bool,float64,append,len,make,nil,true,false},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]",morestring=[b]`}
\lstdefinelanguage{Rust}{
  morekeywords={as,break,const,continue,crate,else,enum,fn,for,if,impl,in,let,loop,match,mod,move,mut,pub,ref,return,self,struct,trait,type,use,where,while},
  morekeywords=[2]{i32,u32,usize,i64,u64,f64,bool,str,String,Vec,Option,Some,None,true,false},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]"}
\lstdefinelanguage{TypeScript}{
  morekeywords={break,case,catch,class,const,continue,default,else,export,extends,finally,for,function,if,import,in,let,new,of,return,switch,this,throw,try,type,interface,var,while},
  morekeywords=[2]{number,string,boolean,void,any,true,false,null,undefined,console},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]",morestring=[b]'}
\lstdefinelanguage{JS}{
  morekeywords={break,case,catch,class,const,continue,default,else,export,extends,finally,for,function,if,import,in,let,new,of,return,switch,this,throw,try,var,while},
  morekeywords=[2]{true,false,null,undefined,console},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]",morestring=[b]'}
\lstdefinelanguage{PyX}{
  morekeywords={def,return,for,in,range,if,else,elif,while,import,from,class,None,True,False,print,len},
  sensitive=true, morecomment=[l]{\#}, morestring=[b]",morestring=[b]'}
\lstdefinelanguage{JavaX}{
  morekeywords={public,class,static,void,int,for,if,return,new,import,else,while,private,final},
  morekeywords=[2]{String,ArrayList,Arrays,Integer,System,true,false,null},
  sensitive=true, morecomment=[l]{//}, morecomment=[s]{/*}{*/}, morestring=[b]"}

\lstset{
  basicstyle=\ttfamily\fontsize{9}{10}\selectfont\color{ink},
  keywordstyle=\color{violet}\bfseries,
  keywordstyle=[2]\color{sky},
  commentstyle=\color{muted}\itshape,
  stringstyle=\color{orange!80!black},
  numbers=left, numberstyle=\tiny\color{muted}, numbersep=8pt,
  backgroundcolor=\color{softgray},
  frame=single, rulecolor=\color{seccol!35}, framerule=0.5pt,
  framexleftmargin=4pt, xleftmargin=18pt, xrightmargin=2pt,
  aboveskip=0pt, belowskip=6pt,
  showstringspaces=false, tabsize=4, breaklines=true,
  columns=fullflexible, keepspaces=true}

% Keep a listing on one page when it fits: Needspace is computed from the line count (capped at a page).
\newcount\dsacodeneed
\newcommand{\dsakeep}[1]{\dsacodeneed=\numexpr #1*74/100+5\relax
  \ifnum\dsacodeneed>46 \dsacodeneed=46 \fi
  \Needspace{\dsacodeneed\baselineskip}}
% \codefile[lines]{lstlanguage}{path under code/}{label}: a coloured language tab above a listing
\newcommand{\codefile}[4][0]{%
  \ifnum#1>0 \dsakeep{#1}\fi
  \par\nopagebreak\smallskip
  \begin{tcolorbox}[enhanced, colback=seccol, colframe=seccol, boxrule=0pt, arc=3pt,
    left=8pt, right=8pt, top=2pt, bottom=2pt, before skip=6pt, after skip=0pt,
    nobeforeafter, fontupper=\semibold\color{white}\small, halign=left]#4\end{tcolorbox}\nopagebreak
  \lstinputlisting[language=#2]{code/#3}}
% \codesection[lines]{Title}{lstlanguage}{file}{label}: subsection + listing, kept together
\newcommand{\codesection}[5][20]{\dsakeep{#1}\subsection{#2}\codefile{#3}{#4}{#5}}

%-------------------------------------------------------------- COVER
% \dsacover{kicker}{title (use \\ for line breaks)}{subtitle}{description}
\newcommand{\dsacover}[4]{%
\thispagestyle{empty}
\begin{tikzpicture}[remember picture, overlay]
  \fill[navy] (current page.south west) rectangle (current page.north east);
  \fill[teal, opacity=0.28] ([xshift=-1.5cm, yshift=-1.2cm]current page.north east) circle (5.5cm);
  \draw[white, opacity=0.07, line width=1pt] ([xshift=-1.5cm, yshift=-1.2cm]current page.north east) circle (7cm);
  \draw[white, opacity=0.05, line width=1pt] ([xshift=-1.5cm, yshift=-1.2cm]current page.north east) circle (8.5cm);
  \fill[gold, opacity=0.10] ([xshift=2cm, yshift=1cm]current page.south west) circle (4.5cm);
  \node[anchor=north west, text=gold, font=\semibold\small\addfontfeature{LetterSpace=14}]
    at ([xshift=1.27cm, yshift=-1.9cm]current page.north west) {#1};
  \node[anchor=north west, text=white, font=\extrabold\fontsize{46}{50}\selectfont, align=left]
    at ([xshift=1.2cm, yshift=-2.7cm]current page.north west) {#2};
  \node[anchor=north west, text=gold, font=\semibold\fontsize{19}{24}\selectfont, align=left, text width=15cm]
    at ([xshift=1.27cm, yshift=-6.6cm]current page.north west) {#3};
  \fill[gold] ([xshift=1.27cm, yshift=-8.25cm]current page.north west) rectangle ++(3cm,-0.07cm);
  \node[anchor=north west, text=white!80!navy, font=\normalsize, align=left, text width=15cm]
    at ([xshift=1.27cm, yshift=-8.7cm]current page.north west) {#4};
\end{tikzpicture}}
% \dsastat[colour]{x offset}{big text}{label}: glass stat card on the cover
\newcommand{\dsastat}[4][gold]{%
  \node[anchor=north west, minimum width=4.25cm, minimum height=2.5cm, text width=3.75cm, align=left,
    fill=white, fill opacity=0.07, text opacity=1, draw=white, draw opacity=0.22, rounded corners=6pt]
    (sc) at ([xshift=#2, yshift=-11.2cm]current page.north west)
    {{\color{#1}\extrabold\fontsize{24}{28}\selectfont #3}\\[4pt]{\color{white!82!navy}\small #4}};
  \fill[#1, rounded corners=1.5pt] ([xshift=0.25cm, yshift=-0.02cm]sc.north west) rectangle ([xshift=1.45cm, yshift=-0.1cm]sc.north west);}
% \dsachip{column}{row}{label}{text}: clickable cover shortcut showing the section's page number
\newcommand{\dsachip}[4]{%
  \node[anchor=north west, minimum width=2.93cm, minimum height=0.68cm, inner xsep=6pt, inner ysep=0pt,
    fill=white, fill opacity=0.07, text opacity=1, draw=white, draw opacity=0.22, rounded corners=4pt]
    at ([xshift={1.27cm+#1*3.106cm}, yshift={-14.9cm-#2*0.82cm}]current page.north west)
    {\hyperref[#3]{\makebox[2.51cm][l]{\strut\color{white}\small #4\hfill\color{gold}\semibold\pageref*{#3}}}};}
